# ============ Domínio ============
# Um único domínio concentra tudo (landing, app, admin e API por /api),
# roteado por caminho no Caddy — ver infra/caddy/Caddyfile.
# Sempre hostname puro, SEM esquema (nada de "http://" ou "https://" aqui).
# Dev local (default): Caddy emite certificado interno automaticamente para *.localhost.
DOMAIN=localhost
# Produção: comente a linha acima e descomente a de baixo (DNS apontando pro VPS).
# DOMAIN=couthealth.com.br

# ============ Postgres ============
POSTGRES_USER=couthealth
POSTGRES_PASSWORD=changeme
POSTGRES_DB=couthealth
DATABASE_URL=postgresql://couthealth:changeme@postgres:5432/couthealth?schema=public

# ============ Redis ============
REDIS_URL=redis://redis:6379

# ============ MinIO ============
MINIO_ROOT_USER=couthealth
MINIO_ROOT_PASSWORD=changeme123
MINIO_BUCKET=couthealth
MINIO_ENDPOINT=minio
MINIO_PORT=9000

# ============ Auth ============
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_REFRESH_SECRET=changeme-generate-another-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple — Services ID + chave .p8 do Apple Developer Portal.
# Enquanto estiverem vazios, o botão "Continuar com Apple" nem aparece no front
# (GET /auth/providers informa o que está configurado).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Conteúdo do .p8 numa linha só, com as quebras escapadas como \n
APPLE_PRIVATE_KEY=

# ============ Pagamento (Stripe para cartão/recorrência; Mercado Pago para PIX) ============
# Cartão vira assinatura recorrente mensal (o Stripe cobra todo mês e cancela sozinho no fim do
# período via cancel_at); PIX vira pagamento único do período, processado pelo Mercado Pago.
# Checkout do cartão é 100% embutido no próprio site (Embedded Checkout), com Apple Pay/Google Pay
# aparecendo quando o dispositivo é elegível.
# STRIPE_SECRET_KEY e STRIPE_PUBLISHABLE_KEY: Stripe Dashboard > Developers > API keys.
# STRIPE_WEBHOOK_SECRET: Stripe Dashboard > Developers > Webhooks (endpoint /api/payments/webhook/stripe) —
# sem ele, o webhook recusa qualquer chamada e a liberação/cobranças recorrentes não funcionam.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# PIX: credenciais do Mercado Pago (Dashboard > Developers). Webhook opcional em
# /api/payments/webhook/mercadopago — a liberação do PIX também ocorre pelo polling do front.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# ============ API ============
API_PORT=3000
NODE_ENV=development
# Vazio = CORS liberado (útil em dev). Em produção, restrinja aos domínios reais.
CORS_ORIGINS=

# ============ Stitch (NUNCA commitar valor real) ============
STITCH_API_KEY=
# ============ Resumo inteligente da anamnese (IA de apoio — nunca prescreve) ============
# A IA apenas organiza/sintetiza a anamnese para o profissional analisar. Qualquer
# provedor OpenAI-compatível funciona (OpenAI, DeepSeek, OpenRouter, Groq...).
# Sem AI_API_KEY o botão mostra aviso — o resto da plataforma não é afetado.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
